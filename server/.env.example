# Database & Server
PORT=5001
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/kamartaj
JWT_SECRET=replace_with_a_secure_random_jwt_secret

# Approved College Email Domains (comma-separated, exact match, case-insensitive)
# Example: mnnit.ac.in,kamartaj.edu
COLLEGE_EMAIL_DOMAINS=kamartaj.edu,mnnit.ac.in

# Email / SMTP Settings for OTP Verification Delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-sender-email@gmail.com
SMTP_PASS=your-google-app-password
EMAIL_FROM=your-sender-email@gmail.com

